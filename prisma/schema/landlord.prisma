model landlords {
  id                   String                 @id @default(cuid())
  userId               String                 @unique
  landlordCode         String?                @unique
  businessName         String?
  isDeleted            Boolean                @default(false)
  stripeCustomerId     String?                @unique
  emailDomains         String?                @unique
  identityVerificationStatus LandlordIdentityVerificationStatus @default(NONE)
  identityDocumentUrls String[]               @default([])
  identityVerifiedAt   DateTime?
  identityVerificationSkippedAt DateTime?
  identitySubmittedAt  DateTime?
  identityRejectedAt   DateTime?
  onboardingTenantsSkippedAt DateTime?
  onboardingFinanceSkippedAt DateTime?
  onboardingCompletedAt DateTime?
  onboardingTermsVersion String?
  Broadcast            Broadcast[]
  BroadcastCategory    BroadcastCategory[]
  globalSettings       Settings[]
  SupportTicket        SupportTicket[]        @relation("TicketRaisedBy")
  applicationInvites   applicationInvites[]
  bankInfo             bankInfo[]
  billsSubCategory     billsSubCategory[]
  user                 users                  @relation(fields: [userId], references: [id])
  maintenances         maintenance[]          @relation("landlordUser")
  maintenanceWhitelist maintenanceWhitelist[]
  property             properties[]
  propertySettings     propertySettings[]
  reviews              reviews[]
  tenants              tenants[]
  Event                Event[]

  PropertyEnquiry PropertyEnquiry[]
  createdStates   state[]
}

enum LandlordIdentityVerificationStatus {
  NONE
  PENDING
  VERIFIED
  SKIPPED
}

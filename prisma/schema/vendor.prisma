enum VendorVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model vendors {
  id                 String                   @id @default(cuid())
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  userId             String?                  @unique
  Event              Event[]
  VendorAvailability VendorAvailability[]
  bankInfo           bankInfo[]
  maintenances       maintenance[]            @relation("vendorUser")
  reviews            reviews[]
  services           services[]
  documents          vendorDocument[]         @relation("VendorDocuments")
  user               users?                   @relation(fields: [userId], references: [id])

  // Onboarding verification gate (Part 1 of VENDOR_APP_FLOW_SPEC.md) - a
  // vendor cannot access the main app until this is APPROVED, regardless of
  // how much of Session 2 (services setup) they've completed.
  verificationStatus VendorVerificationStatus @default(PENDING)

  // Business details, captured once during onboarding and reused wherever
  // needed (invoices, quotations, receipts) instead of re-asking. Optional -
  // a sole trader without a registered company is not blocked by this.
  businessName               String?
  businessRegistrationNumber String?

  // Dispatch geography (Part 16 of VENDOR_APP_FLOW_SPEC.md): jobs are only
  // shown to vendors in the same city as the property OR within a 10-mile
  // radius. City comes from the vendor's profile; these coords enable the
  // radius half of the rule (populated by geocoding/app location - nullable
  // until then, in which case only the city match applies).
  latitude  Decimal? @db.Decimal(18, 6)
  longitude Decimal? @db.Decimal(18, 6)

  maintenanceAssignmentHistory maintenanceAssignmentHistory[]

  maintenanceStatusHistory maintenanceStatusHistory[]

  MaintenanceQuote MaintenanceQuote[]

  payouts Payout[]
}

model vendorDocument {
  id        String   @id @default(cuid())
  url       String
  type      String
  vendorId  String
  createdAt DateTime @default(now())
  vendor    vendors  @relation("VendorDocuments", fields: [vendorId], references: [id])
}

// Admin-controlled (AsherAdmin) list of document types required at vendor
// onboarding - replaces the hardcoded ID_CARD/CERTIFICATION pair previously
// baked into the Vendor app's documentUpload.tsx.
model vendorDocumentRequirement {
  id        String   @id @default(cuid())
  type      String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

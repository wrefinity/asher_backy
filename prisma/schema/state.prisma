model state {
  id                   String      @id @default(cuid())
  name                 String?
  /// Display name of the country for this state/region (e.g. United Kingdom, Nigeria)
  country              String?
  isDeleted            Boolean     @default(false)
  /// The landlord who created this state/location entry (optional – shared states won't have this)
  createdByLandlordId  String?
  properties           properties[]
  createdByLandlord    landlords?  @relation(fields: [createdByLandlordId], references: [id])

  @@index([id])
  @@index([name])
  @@index([createdByLandlordId])
}
